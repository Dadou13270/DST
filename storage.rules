rules_version = '2';
// Vidéos des scénarios (Firebase Storage) : lecture pour les connectés, envoi réservé aux gestionnaires, 50 Mo maximum, vidéo uniquement.
service firebase.storage {
  match /b/{bucket}/o {
    function gest() {
      return request.auth != null
        && (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
            || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get("gestionnaire", false) == true);
    }
    match /scenarios-video/{f} {
      allow read: if request.auth != null;
      allow create: if gest() && request.resource.size <= 50 * 1024 * 1024 && request.resource.contentType.matches('video/.*');
      allow delete: if gest();
    }
  }
}
