rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = utilisateur authentifié dont l'UID existe dans la collection "admins"
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isGest() {
      return request.auth != null && (isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("gestionnaire", false) == true);
    }
    // Co-formateurs : une équipe (ou une salle) peut être pilotée par son créateur et par les gestionnaires listés dans "co".
    function gestTeam(tid) {
      return get(/databases/$(database)/documents/teams/$(tid)).data.owner == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/teams/$(tid)).data.get("co", []);
    }
    // Un stagiaire peut appartenir à 4 équipes au plus : champs equipeId (principale), equipeId2, equipeId3, equipeId4.
    function aEquipe(r, tid) {
      return tid != null && (r.get("equipeId", null) == tid || r.get("equipeId2", null) == tid || r.get("equipeId3", null) == tid || r.get("equipeId4", null) == tid);
    }
    function gestSlot(tid) { return tid != null && gestTeam(tid); }
    function gestAny(r) {
      return gestSlot(r.get("equipeId", null)) || gestSlot(r.get("equipeId2", null)) || gestSlot(r.get("equipeId3", null)) || gestSlot(r.get("equipeId4", null));
    }
    function tOwner(tid, g) { return tid != null && get(/databases/$(database)/documents/teams/$(tid)).data.owner == g; }
    function tPilote(tid, g) {
      return tid != null && (get(/databases/$(database)/documents/teams/$(tid)).data.owner == g
        || g in get(/databases/$(database)/documents/teams/$(tid)).data.get("co", []));
    }
    // Un identifiant d'équipe écrit par le stagiaire doit déjà figurer dans son profil ou correspondre au code qu'il vient de saisir.
    function slotAjoutOk(v, o, n) {
      return v == null || aEquipe(o, v)
        || get(/databases/$(database)/documents/codes/$(n.get("equipeCodeAjout", n.get("equipeCode", "_")))).data.teamId == v;
    }
    function slotsAjoutOk(n, o) {
      return slotAjoutOk(n.get("equipeId", null), o, n) && slotAjoutOk(n.get("equipeId2", null), o, n)
        && slotAjoutOk(n.get("equipeId3", null), o, n) && slotAjoutOk(n.get("equipeId4", null), o, n);
    }
    // Le gestionnaire ne peut retirer que ses propres équipes et n'ajouter qu'à ses propres équipes.
    function slotGestOk(v, o) { return v == null || aEquipe(o, v) || gestTeam(v); }
    function perdOk(v, n) { return v == null || gestTeam(v) || aEquipe(n, v); }
    function slotsGestOk(n, o) {
      return slotGestOk(n.get("equipeId", null), o) && slotGestOk(n.get("equipeId2", null), o)
        && slotGestOk(n.get("equipeId3", null), o) && slotGestOk(n.get("equipeId4", null), o)
        && perdOk(o.get("equipeId", null), n) && perdOk(o.get("equipeId2", null), n)
        && perdOk(o.get("equipeId3", null), n) && perdOk(o.get("equipeId4", null), n);
    }
    function gestSalle(code) {
      return get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid
        || request.auth.uid in get(/databases/$(database)/documents/salles/$(code)).data.get("co", []);
    }
    // Admin de département : gère les gestionnaires et lit les statistiques de son seul département (champ users/{uid}.adminDept).
    function monDept() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("adminDept", "");
    }
    function deptOk(d) {
      return request.auth != null && monDept() != "" && d == monDept();
    }
    // Éditeur de scénarios ouvert aux gestionnaires (site/droits : mode "tous", ou "choix" + liste de départements).
    function editeurOk() {
      return isGest() && exists(/databases/$(database)/documents/site/droits)
        && (get(/databases/$(database)/documents/site/droits).data.get("mode", "aucun") == "tous"
            || (get(/databases/$(database)/documents/site/droits).data.get("mode", "aucun") == "choix"
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("departement", "") in get(/databases/$(database)/documents/site/droits).data.get("deps", [])));
    }
    function quizOk() {
      return isGest() && exists(/databases/$(database)/documents/site/droits)
        && (get(/databases/$(database)/documents/site/droits).data.get("quiz", {}).get("mode", "aucun") == "tous"
            || (get(/databases/$(database)/documents/site/droits).data.get("quiz", {}).get("mode", "aucun") == "choix"
                && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("departement", "") in get(/databases/$(database)/documents/site/droits).data.get("quiz", {}).get("deps", [])));
    }
    function userActif() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.statut != "suspendu";
    }

    // Le premier admin se crée à la main dans la console ; ensuite on les gère depuis Paramètres > Utilisateurs.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && request.auth.uid != uid; // on ne s'auto-modifie pas
    }

    // Profils : inscription libre (statut "actif"), gestion par les admins.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin()
        // un gestionnaire voit les utilisateurs de son CIS (pour les affecter à une équipe)
        || (isGest() && resource.data.get("cis", "") != ""
            && resource.data.get("cis", "") == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("cis", null)
            && resource.data.get("departement", "") == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("departement", null))
        || deptOk(resource.data.get("departement", ""))
        || gestAny(resource.data));
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.statut == "actif"
        && !("gestionnaire" in request.resource.data)
        && !("adminDept" in request.resource.data)
        && (!("equipeId" in request.resource.data)
            || get(/databases/$(database)/documents/codes/$(request.resource.data.equipeCode)).data.teamId == request.resource.data.equipeId);
      allow update: if isAdmin()
        // l'admin de département accorde ou retire le droit gestionnaire dans son département
        || (deptOk(resource.data.get("departement", "")) && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["gestionnaire"]))
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["derniereConnexion", "email", "nom", "bilans", "encours", "equipeId", "equipeNom", "equipeCode", "equipeGest", "equipeId2", "equipeId3", "equipeId4", "equipes", "equipeCodeAjout", "grade", "cis", "departement", "mdpProvisoire", "reponses", "calculs"])
            && slotsAjoutOk(request.resource.data, resource.data))
        // le gestionnaire peut commenter les exercices d'un membre de son équipe
        || (gestAny(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["commentaires"]))
        // le gestionnaire peut affecter, déplacer ou retirer un membre de ses équipes (les autres équipes du stagiaire sont préservées)
        || ((gestAny(resource.data)
              || (isGest() && resource.data.get("cis", "") != ""
                  && resource.data.get("cis", "") == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("cis", null)
                  && resource.data.get("departement", "") == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("departement", null)))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["equipeId", "equipeNom", "equipeCode", "equipeGest", "equipeId2", "equipeId3", "equipeId4", "equipes"])
            && slotsGestOk(request.resource.data, resource.data)));
      // suppression : par un admin (pas lui-même), ou par la personne elle-même (droit à l'effacement ; un admin doit d'abord perdre ses droits)
      allow delete: if (isAdmin() && request.auth.uid != uid) || (request.auth != null && request.auth.uid == uid && !isAdmin());
    }

    // Carnet personnel (favoris, notes) : strictement privé, même pour les admins et gestionnaires.
    match /users/{uid}/perso/{d} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Messagerie privée stagiaire <-> gestionnaire de son équipe : lisible uniquement par les deux participants.
    match /messages/{id} {
      function gestDe(stag, g) {
        let st = get(/databases/$(database)/documents/users/$(stag)).data;
        return tPilote(st.get("equipeId", null), g) || tPilote(st.get("equipeId2", null), g)
          || tPilote(st.get("equipeId3", null), g) || tPilote(st.get("equipeId4", null), g);
      }
      allow read: if request.auth != null && (resource.data.stagId == request.auth.uid || resource.data.gestId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.de == request.auth.uid
        && (request.resource.data.de == request.resource.data.stagId || request.resource.data.de == request.resource.data.gestId)
        && request.resource.data.texte is string && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 2000
        && request.resource.data.lu == false
        && gestDe(request.resource.data.stagId, request.resource.data.gestId);
      allow update: if request.auth != null && resource.data.de != request.auth.uid
        && (resource.data.stagId == request.auth.uid || resource.data.gestId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lu"]);
      allow delete: if request.auth != null && resource.data.stagId == request.auth.uid;
    }

    // Journal d'audit : écriture par les admins (ou traces d'export / suppression de soi), lecture admin, jamais modifiable.
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.par == request.auth.uid
        && (isAdmin() || request.resource.data.action in ["export_donnees", "suppression_compte"]);
      allow update, delete: if false;
    }

    // Équipes : créées par un gestionnaire, lues par le gestionnaire, un admin ou un membre
    match /teams/{tid} {
      allow read: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid
        || request.auth.uid in resource.data.get("co", [])
        || deptOk(resource.data.get("departement", ""))
        || aEquipe(get(/databases/$(database)/documents/users/$(request.auth.uid)).data, tid));
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid)
        || (isGest() && request.auth.uid in resource.data.get("co", [])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["owner", "co", "coNoms"]));
      allow delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }
    // Codes d'accès : lecture unitaire (pas de liste) pour rejoindre une équipe
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }

    // Bibliothèque d'illustrations réutilisables (admin uniquement)
    match /illustrations/{iid} {
      allow read, write: if isAdmin();
    }

    // Le stagiaire est-il dans une équipe de ce gestionnaire ?
    function membreDe(owner) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return tOwner(me.get("equipeId", null), owner) || tOwner(me.get("equipeId2", null), owner)
        || tOwner(me.get("equipeId3", null), owner) || tOwner(me.get("equipeId4", null), owner);
    }
    function scenarioVisible(d) {
      return d.publie == true && userActif()
        && (d.get("reserveA", null) == null || d.reserveA == request.auth.uid || membreDe(d.reserveA));
    }

    // Statistiques d'inscrits : une fiche par utilisateur (département + dernier passage), lisible par tout compte connecté
    // Séance en salle : salle ouverte par un gestionnaire ; les stagiaires rejoignent avec le code.
    // Les questions ne sont lisibles que par le formateur (propriétaire) et les admins.
    match /salles/{code} {
      allow read: if request.auth != null && userActif();
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid)
        || (isGest() && request.auth.uid in resource.data.get("co", [])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["owner", "co", "coNoms"]));
      allow delete: if isAdmin() || (isGest() && (resource.data.owner == request.auth.uid || request.auth.uid in resource.data.get("co", [])));
      match /participants/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || gestSalle(code));
        allow create, update: if request.auth != null && request.auth.uid == uid && userActif()
          && get(/databases/$(database)/documents/salles/$(code)).data.get("ouverte", true) == true
          && (get(/databases/$(database)/documents/salles/$(code)).data.get("debut", null) == null
              || get(/databases/$(database)/documents/salles/$(code)).data.debut <= request.time.toMillis());
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || gestSalle(code));
      }
      // Discussion : le formateur et les participants de la salle lisent et écrivent ; le formateur peut supprimer.
      match /messages/{mid} {
        allow read: if request.auth != null && (isAdmin()
          || gestSalle(code)
          || exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid)));
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && userActif()
          && request.resource.data.texte.size() <= 400
          && (gestSalle(code)
              || exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid)));
        allow delete: if request.auth != null && (isAdmin()
          || gestSalle(code));
      }
      match /questions/{qid} {
        allow read, delete: if request.auth != null && (isAdmin()
          || gestSalle(code));
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && userActif()
          && exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid));
      }
    }

    // Historique des séances : bilan archivé, lisible et supprimable par son formateur (ou un admin)
    match /seances/{sid} {
      allow read, delete: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid
        || request.auth.uid in resource.data.get("co", []));
      allow create, update: if isGest() && (request.resource.data.owner == request.auth.uid
        || request.auth.uid in request.resource.data.get("co", []));
    }

    match /stats/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["d", "seen"]);
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    // Demandes pour devenir gestionnaire : une par utilisateur, traitée par l'admin
    match /demandesGest/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid) || deptOk(resource.data.get("departement", ""));
      allow create, update: if request.auth != null && request.auth.uid == uid && userActif()
        && request.resource.data.uid == uid && request.resource.data.statut == "attente";
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow update: if deptOk(resource.data.get("departement", ""))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "raison", "traiteLe", "traitePar"]);
    }

    // Annonces globales : lues par tout compte connecté, gérées par l'admin
    match /annonces/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      // l'admin de département publie des annonces limitées à son département
      allow create, update: if request.auth != null && monDept() != ""
        && request.resource.data.get("deptAuteur", "") == monDept()
        && request.resource.data.cible.type in ["dep", "cis"] && request.resource.data.cible.dep == monDept()
        && (request.method == "create" || resource.data.get("deptAuteur", "") == monDept());
      allow delete: if request.auth != null && monDept() != "" && resource.data.get("deptAuteur", "") == monDept();
    }

    // Demandes de scénarios : créées par un gestionnaire ou un stagiaire, traitées par l'admin
    match /demandesScenario/{rid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.demandeur == request.auth.uid);
      allow create: if request.auth != null && userActif() && request.resource.data.demandeur == request.auth.uid && request.resource.data.statut == "nouvelle";
      allow update: if isAdmin();
      allow delete: if isAdmin() || (request.auth != null && resource.data.demandeur == request.auth.uid);
    }

    // Support : tickets (propriétaire + admin) et messages en direct.
    match /tickets/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.statut == "ouvert";
      allow update: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "maj", "nonLuAdmin", "nonLuUser"]));
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      match /messages/{m} {
        allow read: if request.auth != null && (get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.de == (isAdmin() ? "admin" : "user")
          && (isAdmin() || get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid);
        allow delete: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid);
      }
    }

    // Parcours (séquences d'exercices) : lecture par le propriétaire ou si partagé ; écriture par les gestionnaires
    // Fiches d'évaluation : écrites par le gestionnaire évaluateur, lues par lui et par le stagiaire évalué.
    match /evaluations/{id} {
      allow read: if request.auth != null && (isAdmin() || resource.data.gestId == request.auth.uid || resource.data.stagId == request.auth.uid);
      allow create, update: if isGest() && request.resource.data.gestId == request.auth.uid;
      allow delete: if isAdmin() || (isGest() && resource.data.gestId == request.auth.uid);
    }

    match /parcours/{id} {
      allow read: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid || resource.data.get("partage", false) == true);
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }

    match /site/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /nouveautes/{id} {
      allow read: if true; // publiques : affichées sur le site de présentation
      allow write: if isAdmin();
    }

    // Jeu « Trivial pompiers » : questions ajoutées par l'admin ; parties enregistrées par les joueurs, lues par l'admin.
    match /jeuQuestions/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Forum d'entraide : l'admin gère rubriques et modérateurs (forumMods) ; les modérateurs masquent, épinglent, verrouillent, suppriment.
    function isForumMod() {
      return isAdmin() || (request.auth != null && exists(/databases/$(database)/documents/forumMods/$(request.auth.uid)));
    }
    match /forumMods/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /forumCats/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /forumSujets/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || isForumMod()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nb", "maj", "dernierNom", "dernierUid"]));
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isForumMod());
    }
    match /forumMsgs/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || isForumMod()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["merci"]));
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isForumMod());
    }
    match /forumPres/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }
    match /forumSuivis/{id} {
      allow read, write: if request.auth != null && request.auth.uid == id;
    }
    match /forumSign/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isForumMod();
    }

    match /jeuParties/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // Quiz en direct (séance en salle) : document d'état {CODE} (formateur) et réponses {CODE}_{uid} (participants).
    match /quizLive/{id} {
      allow read: if request.auth != null && userActif();
      allow create: if request.auth != null && userActif() && (
        (id.matches('^[A-Z0-9]{5}$') && isGest() && request.resource.data.host == request.auth.uid)
        || (id == request.resource.data.code + "_" + request.auth.uid && request.resource.data.uid == request.auth.uid));
      allow update, delete: if request.auth != null && (isAdmin()
        || resource.data.get("host", "") == request.auth.uid
        || resource.data.get("uid", "") == request.auth.uid);
    }

    // Parties multijoueurs du jeu : document d'état {CODE} (écrit par le formateur) et documents joueur {CODE}_{uid}.
    match /jeuSalles/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && (
        (id.matches('^[A-Z0-9]{4,5}$') && request.resource.data.host == request.auth.uid
          && (isGest() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("adminDept", "") != ""))
        || (id == request.resource.data.code + "_" + request.auth.uid && request.resource.data.uid == request.auth.uid));
      allow update, delete: if request.auth != null && (isAdmin()
        || resource.data.get("host", "") == request.auth.uid
        || resource.data.get("uid", "") == request.auth.uid);
    }

    match /exercicesRelation/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Quiz et QCM : créés par l'admin ou par un gestionnaire autorisé (site/droits.quiz) pour son département.
    match /exercicesQuiz/{id} {
      allow read: if request.auth != null && (isAdmin() || resource.data.get("publie", false) == true
        || resource.data.get("auteur", "") == request.auth.uid);
      allow create: if isAdmin()
        || (quizOk() && request.resource.data.auteur == request.auth.uid && request.resource.data.reserveA == request.auth.uid);
      allow update: if isAdmin()
        || (quizOk() && resource.data.get("auteur", "") == request.auth.uid
            && request.resource.data.auteur == request.auth.uid && request.resource.data.reserveA == request.auth.uid);
      allow delete: if isAdmin() || (isGest() && resource.data.get("auteur", "") == request.auth.uid);
    }

    match /exercicesCalcul/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /scenarios/{id} {
      allow read: if isAdmin() || scenarioVisible(resource.data)
        || (isGest() && resource.data.get("auteur", "") == request.auth.uid);
      allow create: if isAdmin()
        || (editeurOk() && request.resource.data.auteur == request.auth.uid && request.resource.data.reserveA == request.auth.uid);
      allow update: if isAdmin()
        || (editeurOk() && resource.data.get("auteur", "") == request.auth.uid
            && request.resource.data.auteur == request.auth.uid && request.resource.data.reserveA == request.auth.uid);
      allow delete: if isAdmin() || (isGest() && resource.data.get("auteur", "") == request.auth.uid);

      match /media/{m} {
        allow read: if isAdmin()
          || scenarioVisible(get(/databases/$(database)/documents/scenarios/$(id)).data)
          || (isGest() && get(/databases/$(database)/documents/scenarios/$(id)).data.get("auteur", "") == request.auth.uid);
        allow write: if isAdmin()
          || (editeurOk() && get(/databases/$(database)/documents/scenarios/$(id)).data.get("auteur", "") == request.auth.uid);
      }
    }
  }
}
