rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = utilisateur authentifié dont l'UID existe dans la collection "admins"
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isGest() {
      return request.auth != null && (isAdmin()
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("gestionnaire", false) == true);
    }
    function userActif() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.statut != "suspendu";
    }

    // Le premier admin se crée à la main dans la console ; ensuite on les gère depuis Paramètres > Utilisateurs.
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin() && request.auth.uid != uid; // on ne s'auto-modifie pas
    }

    // Profils : inscription libre (statut "actif"), gestion par les admins.
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin()
        || (resource.data.get("equipeId", null) != null
            && get(/databases/$(database)/documents/teams/$(resource.data.equipeId)).data.owner == request.auth.uid));
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.statut == "actif"
        && !("gestionnaire" in request.resource.data)
        && (!("equipeId" in request.resource.data)
            || get(/databases/$(database)/documents/codes/$(request.resource.data.equipeCode)).data.teamId == request.resource.data.equipeId);
      allow update: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["derniereConnexion", "email", "nom", "bilans", "encours", "equipeId", "equipeNom", "equipeCode", "equipeGest", "grade", "cis", "departement", "mdpProvisoire", "reponses"])
            && (request.resource.data.get("equipeId", null) == resource.data.get("equipeId", null)
                || request.resource.data.get("equipeId", null) == null
                || get(/databases/$(database)/documents/codes/$(request.resource.data.equipeCode)).data.teamId == request.resource.data.equipeId))
        // le gestionnaire peut commenter les exercices d'un membre de son équipe
        || (resource.data.get("equipeId", null) != null
            && get(/databases/$(database)/documents/teams/$(resource.data.equipeId)).data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["commentaires"]))
        // le gestionnaire peut déplacer un membre d'une de ses équipes vers une autre
        || (resource.data.get("equipeId", null) != null
            && get(/databases/$(database)/documents/teams/$(resource.data.equipeId)).data.owner == request.auth.uid
            && request.resource.data.get("equipeId", null) != null
            && get(/databases/$(database)/documents/teams/$(request.resource.data.equipeId)).data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["equipeId", "equipeNom", "equipeCode", "equipeGest"]))
        // le gestionnaire peut retirer un membre de son équipe
        || (resource.data.get("equipeId", null) != null
            && get(/databases/$(database)/documents/teams/$(resource.data.equipeId)).data.owner == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["equipeId", "equipeNom", "equipeCode", "equipeGest"])
            && !("equipeId" in request.resource.data));
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // Équipes : créées par un gestionnaire, lues par le gestionnaire, un admin ou un membre
    match /teams/{tid} {
      allow read: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid
        || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("equipeId", null) == tid);
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }
    // Codes d'accès : lecture unitaire (pas de liste) pour rejoindre une équipe
    match /codes/{code} {
      allow get: if request.auth != null;
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }

    // Bibliothèque d'illustrations réutilisables (admin uniquement)
    match /illustrations/{iid} {
      allow read, write: if isAdmin();
    }

    // Le stagiaire est-il dans une équipe de ce gestionnaire ?
    function membreDe(owner) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return me.get("equipeId", null) != null
        && get(/databases/$(database)/documents/teams/$(me.equipeId)).data.owner == owner;
    }
    function scenarioVisible(d) {
      return d.publie == true && userActif()
        && (d.get("reserveA", null) == null || d.reserveA == request.auth.uid || membreDe(d.reserveA));
    }

    // Statistiques d'inscrits : une fiche par utilisateur (département + dernier passage), lisible par tout compte connecté
    // Séance en salle : salle ouverte par un gestionnaire ; les stagiaires rejoignent avec le code.
    // Les questions ne sont lisibles que par le formateur (propriétaire) et les admins.
    match /salles/{code} {
      allow read: if request.auth != null && userActif();
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
      match /participants/{uid} {
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == uid && userActif()
          && get(/databases/$(database)/documents/salles/$(code)).data.get("ouverte", true) == true
          && (get(/databases/$(database)/documents/salles/$(code)).data.get("debut", null) == null
              || get(/databases/$(database)/documents/salles/$(code)).data.debut <= request.time.toMillis());
        allow delete: if request.auth != null && (request.auth.uid == uid || isAdmin()
          || get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid);
      }
      // Discussion : le formateur et les participants de la salle lisent et écrivent ; le formateur peut supprimer.
      match /messages/{mid} {
        allow read: if request.auth != null && (isAdmin()
          || get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid
          || exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid)));
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && userActif()
          && request.resource.data.texte.size() <= 400
          && (get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid
              || exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid)));
        allow delete: if request.auth != null && (isAdmin()
          || get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid);
      }
      match /questions/{qid} {
        allow read, delete: if request.auth != null && (isAdmin()
          || get(/databases/$(database)/documents/salles/$(code)).data.owner == request.auth.uid);
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && userActif()
          && exists(/databases/$(database)/documents/salles/$(code)/participants/$(request.auth.uid));
      }
    }

    match /stats/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["d", "seen"]);
      allow delete: if isAdmin();
    }

    // Demandes de scénarios : créées par un gestionnaire, traitées par l'admin
    match /demandesScenario/{rid} {
      allow read: if isAdmin() || (request.auth != null && resource.data.demandeur == request.auth.uid);
      allow create: if isGest() && request.resource.data.demandeur == request.auth.uid && request.resource.data.statut == "nouvelle";
      allow update, delete: if isAdmin();
    }

    // Support : tickets (propriétaire + admin) et messages en direct.
    match /tickets/{id} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.statut == "ouvert";
      allow update: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["statut", "maj", "nonLuAdmin", "nonLuUser"]));
      allow delete: if isAdmin();
      match /messages/{m} {
        allow read: if request.auth != null && (get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid || isAdmin());
        allow create: if request.auth != null
          && request.resource.data.de == (isAdmin() ? "admin" : "user")
          && (isAdmin() || get(/databases/$(database)/documents/tickets/$(id)).data.uid == request.auth.uid);
        allow delete: if isAdmin();
      }
    }

    // Parcours (séquences d'exercices) : lecture par le propriétaire ou si partagé ; écriture par les gestionnaires
    match /parcours/{id} {
      allow read: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid || resource.data.get("partage", false) == true);
      allow create: if isGest() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if isAdmin() || (isGest() && resource.data.owner == request.auth.uid);
    }

    match /nouveautes/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /scenarios/{id} {
      allow read: if isAdmin() || scenarioVisible(resource.data);
      allow write: if isAdmin();

      match /media/{m} {
        allow read: if isAdmin()
          || scenarioVisible(get(/databases/$(database)/documents/scenarios/$(id)).data);
        allow write: if isAdmin();
      }
    }
  }
}
